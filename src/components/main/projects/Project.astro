---
import { getIconComponent } from "../../../icons/IconAll.astro";

type Technology = {
  icon: string;
};

export interface Props {
  title: string;
  img: string;
  description: string;
  technologies: Technology[];
  link: string;
}

const { technologies, title, img, description, link } = Astro.props;
---

<li class="li-project">
  <img src={img} alt={title} />
  <div class="content-project">
    <h3 class="title-project">{title}</h3>
    <p class="description-project">{description}</p>
    <div class="technologies">
      {
        technologies.map(({ icon }) => {
          const IconComponent = getIconComponent(icon);
          return IconComponent && <div class="icon-wrapper"><IconComponent /></div>;
        })
      }
    </div>
    <a href={link} target="_blank" rel="noopener noreferrer" class="link-project">Ver Proyecto</a>
  </div>
</li>

<style>
  .li-project {
    display: flex;
    flex-direction: column;
    background-color: #1a1a1a;
    border: 1px solid #333;
    border-radius: 12px;
    overflow: hidden;
    color: #f6f6f9;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
  }

  .li-project:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(1, 190, 150, 0.2);
  }

  .li-project img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border-bottom: 1px solid #333;
  }

  .content-project {
    display: flex;
    flex-direction: column;
    padding: 20px;
    flex-grow: 1;
  }

  .title-project {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #01be96;
  }

  .description-project {
    font-size: 15px;
    line-height: 1.5;
    color: #bbb;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .technologies {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .icon-wrapper {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .link-project {
    display: inline-block;
    padding: 10px 20px;
    background-color: transparent;
    color: #01be96;
    text-decoration: none;
    border: 2px solid #01be96;
    border-radius: 6px;
    text-align: center;
    font-weight: 600;
    transition: background-color 0.3s, color 0.3s;
  }

  .link-project:hover {
    background-color: #01be96;
    color: #111;
  }
</style>